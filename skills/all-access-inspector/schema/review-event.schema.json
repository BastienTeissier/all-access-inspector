{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BastienTeissier/all-access-inspector/schema/review-event.schema.json",
  "title": "Review Event",
  "description": "One line of tools/access-inspector/reviews.jsonl: a human Verdict, or an agent Signal or Triage, on one endpoint as it was seen (v 1); or the same on one capability for one role, a cell of the access map, where the human Verdict is a Capability Decision (v 2).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "at", "by", "event", "batch", "endpoint", "seen", "verdict", "reason"],
      "properties": {
        "v": { "$ref": "#/$defs/v" },
        "at": { "$ref": "#/$defs/at" },
        "by": { "$ref": "#/$defs/by" },
        "event": { "const": "reviewed" },
        "batch": { "$ref": "#/$defs/batch" },
        "endpoint": { "$ref": "#/$defs/endpoint" },
        "seen": { "$ref": "#/$defs/seen" },
        "verdict": { "enum": ["safe", "accepted", "finding"] },
        "reason": { "$ref": "#/$defs/text", "maxLength": 2000 },
        "severity": { "enum": ["low", "medium", "high"] },
        "ticket": { "type": "string", "pattern": "^https?://\\S+$" },
        "until": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\d$" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "finding" } } },
          "then": { "required": ["severity"], "not": { "required": ["until"] } },
          "else": { "not": { "anyOf": [{ "required": ["severity"] }, { "required": ["ticket"] }] } }
        },
        {
          "if": { "properties": { "verdict": { "const": "safe" } } },
          "then": { "not": { "required": ["until"] } }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "at", "by", "event", "batch", "endpoint", "seen", "reason", "evidence"],
      "properties": {
        "v": { "$ref": "#/$defs/v" },
        "at": { "$ref": "#/$defs/at" },
        "by": { "$ref": "#/$defs/by" },
        "event": { "const": "signal_raised" },
        "batch": { "$ref": "#/$defs/batch" },
        "endpoint": { "$ref": "#/$defs/endpoint" },
        "seen": { "$ref": "#/$defs/seen" },
        "reason": { "$ref": "#/$defs/text", "maxLength": 500 },
        "evidence": { "type": "string", "pattern": "^[^\\s:]+:\\d+$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "at", "by", "event", "batch", "endpoint", "seen"],
      "properties": {
        "v": { "$ref": "#/$defs/v" },
        "at": { "$ref": "#/$defs/at" },
        "by": { "$ref": "#/$defs/by" },
        "event": { "const": "triaged" },
        "batch": { "$ref": "#/$defs/batch" },
        "endpoint": { "$ref": "#/$defs/endpoint" },
        "seen": { "$ref": "#/$defs/seen" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "at", "by", "event", "batch", "capability", "seen", "verdict", "reason"],
      "properties": {
        "v": { "$ref": "#/$defs/v2" },
        "at": { "$ref": "#/$defs/at" },
        "by": { "$ref": "#/$defs/by" },
        "event": { "const": "decided" },
        "batch": { "$ref": "#/$defs/batch" },
        "capability": { "$ref": "#/$defs/capability" },
        "seen": { "$ref": "#/$defs/cell_seen" },
        "verdict": { "enum": ["safe", "accepted", "finding"] },
        "reason": { "$ref": "#/$defs/text", "maxLength": 2000 },
        "severity": { "enum": ["low", "medium", "high"] },
        "ticket": { "type": "string", "pattern": "^https?://\\S+$" },
        "until": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\d$" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "finding" } } },
          "then": { "required": ["severity"], "not": { "required": ["until"] } },
          "else": { "not": { "anyOf": [{ "required": ["severity"] }, { "required": ["ticket"] }] } }
        },
        {
          "if": { "properties": { "verdict": { "const": "safe" } } },
          "then": { "not": { "required": ["until"] } }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "at", "by", "event", "batch", "capability", "seen", "reason", "evidence"],
      "properties": {
        "v": { "$ref": "#/$defs/v2" },
        "at": { "$ref": "#/$defs/at" },
        "by": { "$ref": "#/$defs/by" },
        "event": { "const": "signal_raised" },
        "batch": { "$ref": "#/$defs/batch" },
        "capability": { "$ref": "#/$defs/capability" },
        "seen": { "$ref": "#/$defs/cell_seen" },
        "reason": { "$ref": "#/$defs/text", "maxLength": 500 },
        "evidence": { "type": "string", "pattern": "^[^\\s:]+:\\d+$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "at", "by", "event", "batch", "capability", "seen"],
      "properties": {
        "v": { "$ref": "#/$defs/v2" },
        "at": { "$ref": "#/$defs/at" },
        "by": { "$ref": "#/$defs/by" },
        "event": { "const": "triaged" },
        "batch": { "$ref": "#/$defs/batch" },
        "capability": { "$ref": "#/$defs/capability" },
        "seen": { "$ref": "#/$defs/cell_seen" }
      }
    }
  ],
  "$defs": {
    "v": { "const": 1 },
    "v2": { "const": 2 },
    "at": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" },
    "by": { "$ref": "#/$defs/text", "maxLength": 320 },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "batch": { "type": ["string", "null"], "pattern": "^b-[0-9a-f]{8}$" },
    "endpoint": {
      "description": "Review Key: method, path, handler with its trailing :<line> stripped.",
      "type": "array",
      "prefixItems": [{ "type": "string" }, { "type": "string" }, { "type": "string" }],
      "minItems": 3,
      "maxItems": 3
    },
    "capability": {
      "description": "Capability id and role id: one cell of the access map.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/text", "maxLength": 200 }, { "$ref": "#/$defs/text", "maxLength": 200 }],
      "minItems": 2,
      "maxItems": 2
    },
    "cell_seen": {
      "description": "The cell as the event saw it: its state, the endpoints the role reached and missed, and who each one lets in as [kind, basis].",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reached", "missed", "who"],
      "properties": {
        "state": { "$ref": "#/$defs/text", "maxLength": 20 },
        "reached": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
        "missed": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
        "who": {
          "type": "object",
          "additionalProperties": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 }
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "layer", "raw", "rule"],
      "properties": {
        "value": { "type": "string" },
        "layer": { "type": ["string", "null"] },
        "raw": { "type": ["string", "null"] },
        "rule": { "type": ["string", "null"] }
      }
    },
    "seen": {
      "description": "The endpoint as the event saw it; inside is null when no expectation applies or an axis is unknown.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handler", "authentication", "authorization", "inside"],
      "properties": {
        "handler": { "type": "string" },
        "authentication": { "$ref": "#/$defs/axis" },
        "authorization": { "$ref": "#/$defs/axis" },
        "inside": { "type": ["boolean", "null"] }
      }
    }
  }
}
