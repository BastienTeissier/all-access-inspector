{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BastienTeissier/all-access-inspector/schema/runtime.schema.json",
  "title": "Map Runtime",
  "description": "tools/access-map/runtime.json: what a stack's Map Introspect read from the code, in stack-neutral terms: the roles, who holds which permission, the scopes and capabilities, and per endpoint the checks the inventory cannot see. Regenerated by the introspect, never edited by hand. A stack with no introspect has none.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stack",
    "base_script",
    "about",
    "roles",
    "grants",
    "scopes",
    "scoped",
    "capabilities",
    "endpoints",
    "snippets"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "stack": {
      "type": "string",
      "minLength": 1
    },
    "base_script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "version"
      ],
      "properties": {
        "stack": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "about": {
      "description": "How this introspect works, for the page's \"How it's built\" tab.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads",
        "holds",
        "heuristics",
        "command"
      ],
      "properties": {
        "reads": {
          "description": "What it asks the framework, in one sentence.",
          "type": "string"
        },
        "holds": {
          "description": "What runtime.json holds, one item each.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heuristics": {
          "description": "Every pattern it reads by heuristic, one item each: these make a badge inferred.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "The command that regenerates runtime.json.",
          "type": "string"
        }
      }
    },
    "roles": {
      "description": "Roles the code defines, sorted by id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "at",
          "basis",
          "includes",
          "staff"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "signed_in",
              "superuser",
              "group"
            ]
          },
          "at": {
            "$ref": "#/$defs/at"
          },
          "basis": {
            "$ref": "#/$defs/fact_basis"
          },
          "includes": {
            "description": "Roles every account of this role also holds.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "at"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "$ref": "#/$defs/at"
                }
              }
            }
          },
          "staff": {
            "description": "Where accounts of this role are made to pass staff checks, or null.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "at"
                ],
                "properties": {
                  "at": {
                    "$ref": "#/$defs/at"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "grants": {
      "description": "Permission name → the roles holding it, each with the file:line that grants it.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "at"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "$ref": "#/$defs/at"
            }
          }
        }
      }
    },
    "scopes": {
      "description": "Record filters, sorted by id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "at",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "$ref": "#/$defs/at"
          },
          "basis": {
            "$ref": "#/$defs/fact_basis"
          }
        }
      }
    },
    "scoped": {
      "description": "Which scope narrows a capability for a role.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "role",
          "scope",
          "at",
          "basis"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "$ref": "#/$defs/at"
          },
          "basis": {
            "$ref": "#/$defs/fact_basis"
          }
        }
      }
    },
    "capabilities": {
      "description": "Capabilities read from the code, sorted by id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "term",
          "verb",
          "endpoints",
          "check",
          "at",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "verb": {
            "enum": [
              "read",
              "write"
            ]
          },
          "endpoints": {
            "description": "Review keys: method, path, handler.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/key"
            }
          },
          "check": {
            "description": "What the code checks for this capability, e.g. a permission name.",
            "type": "string"
          },
          "at": {
            "$ref": "#/$defs/at"
          },
          "basis": {
            "$ref": "#/$defs/fact_basis"
          }
        }
      }
    },
    "endpoints": {
      "description": "Only the endpoints the introspect has something to say about. Keyed like the inventory: method, path, handler.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "path",
          "handler",
          "layers",
          "permissions",
          "verdict",
          "fallback",
          "notes"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "handler": {
            "type": "string"
          },
          "resource": {
            "description": "Overrides the vocabulary's resource label for this endpoint.",
            "type": "string"
          },
          "layers": {
            "description": "Checks the request goes through after the inventory's two axes, in order.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/layer"
            }
          },
          "permissions": {
            "description": "Permission names the checks require, looked up in grants.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict": {
            "description": "What the checks settle on their own, when they do: nobody, superuser, or custom when something decides that the introspect cannot read. Null when the grants decide.",
            "anyOf": [
              {
                "$ref": "#/$defs/who"
              },
              {
                "type": "null"
              }
            ]
          },
          "fallback": {
            "description": "The stack's reading of the authorization rule, used only when neither grants nor a verdict decide (e.g. a superuser-only decorator, or a staff flag every user carries).",
            "anyOf": [
              {
                "$ref": "#/$defs/who"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "description": "Why a badge is weaker than read-from-code: [basis, text] pairs the build appends to the badge's explanation.",
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/basis"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "snippets": {
      "description": "file:line → the source the layers cite, shown in the page.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "basis": {
      "description": "How far to trust a badge, weakest last: extracted (read from code), rule (a reviewed Recognition Rule), curated (hand-written with a file:line), inferred (a heuristic), open (not resolved).",
      "enum": [
        "extracted",
        "rule",
        "curated",
        "inferred",
        "open"
      ]
    },
    "who": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "basis",
        "how"
      ],
      "properties": {
        "kind": {
          "enum": [
            "anyone",
            "signed_in",
            "staff",
            "groups",
            "superuser",
            "nobody",
            "custom"
          ]
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "how": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "text",
        "source"
      ],
      "properties": {
        "kind": {
          "description": "permission: a permission check; scope: narrows which records exist; view: the page handler itself; write: checked on save; body: inside the handler.",
          "enum": [
            "permission",
            "scope",
            "view",
            "write",
            "body"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "source": {
          "description": "Where the build learnt it: the introspect, the framework, or curated.",
          "type": "string",
          "minLength": 1
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "description": "Permission names this layer checks, looked up in grants.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "at": {
      "description": "file:line relative to the project root.",
      "type": "string",
      "pattern": "^[^\\s:]+:\\d+$"
    },
    "fact_basis": {
      "description": "How the introspect learnt a fact: extracted (read from the framework), rule (a Map Rule), inferred (a filter read by heuristic).",
      "enum": [
        "extracted",
        "rule",
        "inferred"
      ]
    },
    "key": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
